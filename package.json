{
    "name": "relatorios-dominio",
    "productName": "Prazos",
    "version": "1.0.0",
    "private": true,
    "description": "Aplicativo desktop: conecta ao banco do Domínio (somente leitura) e gera o Relatório de Vencimentos de Férias, Experiência e Afastamentos em PDF.",
    "author": "Escritório",
    "main": "dist-electron/main.js",
    "scripts": {
        "build:ui": "vite build",
        "build:electron": "node scripts/build-electron.mjs",
        "build": "npm run build:ui && npm run build:electron",
        "start": "npm run build && electron .",
        "dev": "node scripts/dev.mjs",
        "test": "vitest run",
        "typecheck": "tsc --noEmit",
        "dist": "npm run build && electron-builder"
    },
    "dependencies": {
        "mammoth": "^1.13.0",
        "odbc": "^2.4.9",
        "pdfjs-dist": "^4.10.38",
        "pdfkit": "^0.20.2"
    },
    "devDependencies": {
        "@fontsource-variable/inter": "^5.2.5",
        "@radix-ui/react-dialog": "^1.1.23",
        "@radix-ui/react-select": "^2.3.7",
        "@radix-ui/react-slot": "^1.3.3",
        "@tailwindcss/vite": "^4",
        "@types/node": "^22",
        "@types/pdfkit": "^0.17.6",
        "@types/react": "^19",
        "@types/react-dom": "^19",
        "@vitejs/plugin-react": "^5",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "electron": "^33.0.0",
        "electron-builder": "^25.1.8",
        "esbuild": "^0.25.0",
        "lucide-react": "^1.43.0",
        "marked": "^15.0.12",
        "mp4-muxer": "^5.2.2",
        "next-themes": "^0.4.6",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4",
        "tailwindcss-animate": "^1.0.7",
        "typescript": "^5",
        "vite": "^7",
        "vitest": "^3"
    },
    "build": {
        "appId": "com.escritorio.relatoriosdominio",
        "productName": "Prazos",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**",
            "dist-electron/**",
            "build/icon.ico",
            "package.json"
        ],
        "win": {
            "target": "nsis",
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Prazos"
        },
        "npmRebuild": false,
        "asarUnpack": [
            "node_modules/odbc/**"
        ],
        "extraResources": [
            {
                "to": "instalar-driver-odbc.ps1",
                "from": "scripts/instalar-driver-odbc.ps1"
            }
        ],
        "artifactName": "Prazos_Setup.${ext}"
    }
}
